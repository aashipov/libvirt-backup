hostname: debian

users:
  - name: administrator
    groups: [sudo, libvirt]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    passwd: "P@s$W0rld"
    lock_passwd: false

# Do NOT let cloud-init disable root or sshd; we need xrdp later
ssh_pwauth: true
disable_root: false

package_update: true
package_upgrade: true

apt:
  sources_list: |
    deb http://deb.debian.org/debian trixie main contrib non-free
    deb-src http://deb.debian.org/debian trixie main contrib non-free
    deb http://deb.debian.org/debian-security/ trixie-security main contrib non-free
    deb-src http://deb.debian.org/debian-security/ trixie-security main contrib non-free
    deb http://deb.debian.org/debian trixie-updates main contrib non-free
    deb-src http://deb.debian.org/debian trixie-updates main contrib non-free

packages:
  # Base tooling
  - cron
  - git
  - rsync
  - acl
  - sudo
  - qemu-kvm
  - libvirt-daemon-system
  - libvirt-clients
  - bridge-utils
  - tree
  - curl
  - mc
  # GUI / RDP stack
  - virt-manager
  - weston
  - winpr3-utils
  - xrdp
  - xorgxrdp
  - openbox
  - chromium
  - firefox-esr
  - thunar
  - xfce4-terminal
  - xfce4-taskmanager
  - mousepad
  - gvfs
  - gvfs-backends

write_files:
  # libvirt default URI for userspace
  - path: /home/administrator/.config/libvirt/libvirt.conf
    owner: administrator:administrator
    permissions: '0644'
    content: |
      uri_default = "qemu:///system"

  # Openbox session for xrdp
  - path: /home/administrator/.xinitrc
    owner: administrator:administrator
    permissions: '0755'
    content: |
      #!/bin/sh
      export XDG_CURRENT_DESKTOP=openbox
      exec dbus-run-session -- openbox-session

  # Avoid libvirt nested network clash (host 192.168.122.0/24)
  - path: /etc/libvirt/qemu/networks/default.xml
    permissions: '0644'
    content: |
      <network>
        <name>nested</name>
        <forward mode='nat'/>
        <bridge name='virbr1' stp='on' delay='0'/>
        <ip address='192.168.123.1' netmask='255.255.255.0'>
          <dhcp>
            <range start='192.168.123.2' end='192.168.123.254'/>
          </dhcp>
        </ip>
      </network>

runcmd:
  # Enable & start core services
  - [ systemctl, enable, --now, cron ]
  - [ systemctl, enable, --now, libvirtd ]
  - [ systemctl, enable, --now, xrdp ]

  # Autostart default libvirt network
  - [ virsh, net-autostart, default ]
  - [ virsh, net-start, default ]

  # .xinit
  - [ ln, -sf, /home/administrator/.xinitrc, /home/administrator/.xsession ] 
  - [ ln, -sf, /home/administrator/.xinitrc, /home/administrator/.Xclients ]
  - [ ln, -sf, /home/administrator/.xinitrc, /home/administrator/startwm.sh ]

  # Ensure administrator owns their dotfiles
  - [ chown, -R, administrator:administrator, /home/administrator ]

  # Remove cloud-init traces (per guide, cloud-init is undesired on the guest)
  - [ apt-get, remove, -y, cloud-init ]
  - [ rm, -rf, /etc/cloud, /var/lib/cloud ]

power_state:
  mode: reboot
  message: "Reboot after cloud-init headful provisioning"
  timeout: 30
  condition: True
