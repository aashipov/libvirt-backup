# Adwaita-Dark for Openbox 3
# AI-generated, matches GTK3 Adwaita-dark & libadwaita dark palette

# --- Window Geometry & Borders ---
border.width: 1
window.client.padding.width: 0
window.client.padding.height: 0
window.handle.width: 0

padding.width: 8
padding.height: 6

window.active.border.color: #181818
window.inactive.border.color: #1c1c1c
window.active.title.separator.color: #1b1b1b
window.inactive.title.separator.color: #202020

# --- Titlebar & Labels ---
window.active.title.bg: flat gradient vertical
window.active.title.bg.color: #303030
window.active.title.bg.colorTo: #262626

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #222222

window.active.label.bg: parentrelative
window.active.label.text.color: #eeeeec

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #919190

window.label.text.justify: center

# --- Titlebar Buttons (Unpressed) ---
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #dedede

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #777776

# --- Titlebar Buttons (Hover) ---
window.active.button.hover.bg: flat solid border
window.active.button.hover.bg.color: #3a3a3a
window.active.button.hover.bg.border.color: #1f1f1f
window.active.button.hover.image.color: #ffffff

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #2e2e2e
window.inactive.button.hover.image.color: #bdbdbd

# --- Titlebar Buttons (Pressed) ---
window.active.button.pressed.bg: flat solid border
window.active.button.pressed.bg.color: #1d1d1d
window.active.button.pressed.bg.border.color: #141414
window.active.button.pressed.image.color: #ffffff

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #1a1a1a
window.inactive.button.pressed.image.color: #919190

# --- Titlebar Buttons (Toggled & Disabled) ---
window.active.button.toggled.unpressed.bg: flat solid border
window.active.button.toggled.unpressed.bg.color: #202020
window.active.button.toggled.unpressed.bg.border.color: #161616
window.active.button.toggled.unpressed.image.color: #3584e4

window.active.button.toggled.hover.bg: flat solid border
window.active.button.toggled.hover.bg.color: #2a2a2a
window.active.button.toggled.hover.bg.border.color: #161616
window.active.button.toggled.hover.image.color: #62a0ea

window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #777776

window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #555555
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #444444

# --- Right-Click Root Menus ---
menu.border.width: 1
menu.border.color: #181818
menu.overlap.x: -2
menu.overlap.y: 0

menu.title.bg: flat solid
menu.title.bg.color: #242424
menu.title.text.color: #919190
menu.title.text.justify: center

menu.items.bg: flat solid
menu.items.bg.color: #282828
menu.items.text.color: #eeeeec
menu.items.disabled.text.color: #686867

menu.items.active.bg: flat solid
menu.items.active.bg.color: #3584e4
menu.items.active.text.color: #ffffff
menu.items.active.disabled.text.color: #99c1f1

menu.separator.color: #383838
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 4

# --- On-Screen Display (Alt-Tab / Workspace Switcher) ---
osd.border.width: 1
osd.border.color: #181818

osd.bg: flat solid
osd.bg.color: #242424
osd.label.bg: flat solid
osd.label.bg.color: #242424
osd.label.text.color: #eeeeec

osd.hilight.bg: flat solid
osd.hilight.bg.color: #3584e4
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #363636
